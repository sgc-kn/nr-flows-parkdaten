    {
        "id": "0ed9fab01166415e",
        "type": "http request",
        "z": "9efa68a9cad9a746",
        "g": "ec6ed68f9eb040cd",
        "name": "GET",
        "method": "GET",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
