    {
        "id": "50e2154b3e9ead0f",
        "type": "function",
        "z": "9efa68a9cad9a746",
        "g": "fab63b24c022c462",
        "name": "Prepare data",
        "func": "// Extract \"name,\" \"frei,\" and \"belegt\" properties from the JSON data in msg.payload\nconst jsonData = msg.payload;\nconst extractedData = jsonData.features.map(feature => {\n    return {\n        identifier: feature.attributes.OBJECTID,\n        name: feature.attributes.name,\n        kapazitaet: feature.attributes.real_capa,\n        frei: feature.attributes.real_fcap,\n        belegt: Number(feature.attributes.real_capa) - Number(feature.attributes.real_fcap),\n        longitude: feature.geometry.x,\n        latitude: feature.geometry.y\n    };\n});\nmsg.parkhaus = extractedData;\nmsg.payload = \"\";\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 400,
        "wires": [
            [
                "41505a5e65c5cdda"
            ]
        ]
    },
    {
        "id": "41505a5e65c5cdda",
        "type": "function",
        "z": "9efa68a9cad9a746",
        "g": "fab63b24c022c462",
        "name": "Prepare OffStreetParking Datamodel",
        "func": "let entities = []\n\n// Iterate through the array\nfor (const data of msg.parkhaus) {\n\n    const datamodel = {\n        \"id\": \"urn:sdm:OffStreetParking:konstanz:parkhaus-\" + data.identifier,\n        \"type\": \"OffStreetParking\",\n        \"name\": {\n            \"type\": \"Property\",\n            \"value\": data.name\n        },\n        \"observationDateTime\": {\n            \"type\": \"Property\",\n            \"value\": new Date().toISOString()\n        },\n        \"location\": {\n            \"type\": \"GeoProperty\",\n            \"value\": {\n                \"type\": \"Point\",\n                \"coordinates\": [data.longitude, data.latitude]\n            },\n        },\n        \"availableSpotNumber\": {\n            \"type\": \"Property\",\n            \"value\": data.frei,\n            \"observedAt\": new Date().toISOString()\n        },\n        \"occupiedSpotNumber\": {\n            \"type\": \"Property\",\n            \"value\": data.belegt,\n            \"observedAt\": new Date().toISOString()\n        },\n        \"totalSpotNumber\": {\n            \"type\": \"Property\",\n            \"value\": data.kapazitaet,\n            \"observedAt\": new Date().toISOString()\n        },\n        \"@context\": [\n            `https://context.${ env.get(\"DOMAIN\") }/main-context.jsonld`\n        ]\n    }\n\n    entities.push(datamodel)\n}\n\nmsg.payload = entities\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
        "y": 400,
        "wires": [
            [
                "6d0182df26a6035a",
                "dca7dad5b77a9e5e"
            ]
        ]
    },
