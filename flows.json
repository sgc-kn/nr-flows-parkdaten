    {
        "id": "1d220e6387a0d05e",
        "type": "function",
        "z": "9efa68a9cad9a746",
        "g": "ec6ed68f9eb040cd",
        "name": "Prepare API Call Parkplätze GIS",
        "func": "msg.url = \"https://services.gis.konstanz.digital/geoportal/rest/services/Fachdaten/Parkplaetze_Parkleitsystem/MapServer/0/query?where=1%3D1&outFields=*&outSR=4326&f=json\";\n\nreturn msg;",
